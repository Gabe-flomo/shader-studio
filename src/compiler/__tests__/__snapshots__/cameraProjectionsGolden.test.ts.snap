    "u_p_splatwavex0_frequency": 4,
    "u_p_splatwavex0_speed": 0.7,
    "u_p_splatx0_hitAt": 0.5,
    "u_p_splatx0_opacity": 1,
    "u_p_splatx0_position": [
      0,
      0,
      0,
    ],
    "u_p_splatx0_rotation": [
      0,
      0,
      0,
    ],
    "u_p_splatx0_scale": 1,
    "u_p_splatx0_softness": 0.05,
    "u_p_splatx0_splatSize": 1,
  },
  "splats": [
    {
      "modifier": {
        "audioUniforms": {},
        "fragmentShader": "precision highp float;
#define PI 3.1415926538
#define TAU 6.2831853072

uniform vec2 u_resolution;
uniform float u_time;
uniform vec2 u_mouse;
uniform sampler2D u_fontTexture;
uniform float u_p_lfox0_freq;
uniform float u_p_lfox0_phase;
uniform float u_p_lfox0_amplitude;
uniform float u_p_lfox0_offset;
uniform float u_p_splatsetx0_amount;
uniform float u_p_splatexplox0_returnHome;
uniform float u_p_splatexplox0_distance;
uniform vec3 u_p_splatexplox0_center;
uniform float u_p_splatexplox0_scatter;
uniform float u_p_splatexplox0_stagger;
uniform float u_p_splatexplox0_spin;
uniform float u_p_splatwavex0_amplitude;
uniform float u_p_splatwavex0_frequency;
uniform float u_p_splatwavex0_speed;

precision highp int;
uniform highp usampler2D u_spd_smScan;
uniform highp sampler2D u_spp_smScan;
uniform float u_spn_smScan;
uniform vec4 u_spb_smScan;
layout(location = 1) out highp vec4 splatModOut1;
mat3 sp_base; vec3 sp_local; vec3 sp_T; float sp_index; float sp_rand; float sp_count; float sp_radius; vec3 sp_mid; vec3 sp_midW; float sp_unit;
varying vec2 vUv;

// ── Always-available helpers (noise, rotation) ───────────────────────────────
vec2 noiseHash2(vec2 p) {
    p = vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)));
    return -1.0 + 2.0 * fract(sin(p) * 43758.5453123);
}
float noiseHash1(vec2 p) {
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
}
float valueNoise(vec2 p) {
    vec2 i = floor(p); vec2 f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(noiseHash1(i), noiseHash1(i+vec2(1,0)), u.x),
               mix(noiseHash1(i+vec2(0,1)), noiseHash1(i+vec2(1,1)), u.x), u.y);
}
vec2 rotate(vec2 v, float angle) {
    // Hoisted: the angle is usually a uniform expression, and the compiler
    // can't share the four trig calls when the argument isn't a plain value.
    float s = sin(angle), c = cos(angle);
    return vec2(v.x * c - v.y * s, v.x * s + v.y * c);
}
mat2 rot2D(float a) { float s=sin(a), c=cos(a); return mat2(c,-s,s,c); }
// ─────────────────────────────────────────────────────────────────────────

float spHash31(vec3 p) {
    p = fract(p * vec3(0.1031, 0.1030, 0.0973));
    p += dot(p, p.yxz + 33.33);
    return fract((p.x + p.y) * p.z);
}


float spNoise3(vec3 p) {
    vec3 i = floor(p), f = fract(p);
    vec3 u = f * f * (3.0 - 2.0 * f);
    float a = mix(spHash31(i), spHash31(i + vec3(1.0, 0.0, 0.0)), u.x);
    float b = mix(spHash31(i + vec3(0.0, 1.0, 0.0)), spHash31(i + vec3(1.0, 1.0, 0.0)), u.x);
    float c = mix(spHash31(i + vec3(0.0, 0.0, 1.0)), spHash31(i + vec3(1.0, 0.0, 1.0)), u.x);
    float d = mix(spHash31(i + vec3(0.0, 1.0, 1.0)), spHash31(i + vec3(1.0, 1.0, 1.0)), u.x);
    return mix(mix(a, b, u.y), mix(c, d, u.y), u.z);
}




vec3 spNoise33(vec3 p) {
    return vec3(spNoise3(p), spNoise3(p + vec3(31.7, 11.3, 5.9)), spNoise3(p + vec3(63.1, 47.9, 23.3)));
}




mat3 spRotY(float a) { float c = cos(a), s = sin(a); return mat3(c, 0.0, -s, 0.0, 1.0, 0.0, s, 0.0, c); }

void main() {
    int sp_i = int(gl_FragCoord.y) * 2048 + int(gl_FragCoord.x);
    uvec4 sp_a = texelFetch(u_spd_smScan, ivec2((sp_i & 1023) << 1, sp_i >> 10), 0);
    uvec4 sp_b = texelFetch(u_spd_smScan, ivec2(((sp_i & 1023) << 1) | 1, sp_i >> 10), 0);
    vec4 sp_c0 = texelFetch(u_spp_smScan, ivec2(4, 0), 0), sp_c1 = texelFetch(u_spp_smScan, ivec2(5, 0), 0), sp_c2 = texelFetch(u_spp_smScan, ivec2(6, 0), 0);
    mat3 sp_M = mat3(sp_c0.xyz, sp_c1.xyz, sp_c2.xyz);
    sp_T = texelFetch(u_spp_smScan, ivec2(7, 0), 0).xyz;
    vec3 sp_p = uintBitsToFloat(sp_a.xyz);
    float sp_scale = length(sp_c0.xyz);
    sp_local = sp_p * vec3(1.0, -1.0, -1.0) * sp_scale;
    vec4 sp_rgba = vec4(float(sp_a.w & 255u), float((sp_a.w >> 8) & 255u), float((sp_a.w >> 16) & 255u), float(sp_a.w >> 24)) / 255.0;
    vec2 sp_u1 = unpackHalf2x16(sp_b.x), sp_u2 = unpackHalf2x16(sp_b.y), sp_u3 = unpackHalf2x16(sp_b.z);
    sp_radius = sqrt(max(0.25 * (sp_u1.x + sp_u2.y + sp_u3.y), 0.0) / 3.0) * sp_c0.w * sp_scale;
    uint sp_h = uint(sp_i) * 747796405u + 2891336453u;
    sp_h = ((sp_h >> ((sp_h >> 28u) + 4u)) ^ sp_h) * 277803737u;
    sp_h = (sp_h >> 22u) ^ sp_h;
    sp_rand = float(sp_h >> 8u) / 16777216.0;
    sp_index = float(sp_i);
    sp_count = u_spn_smScan;
    sp_mid = u_spb_smScan.xyz * vec3(1.0, -1.0, -1.0) * sp_scale;
    sp_midW = sp_M * u_spb_smScan.xyz + sp_T;
    sp_unit = max(u_spb_smScan.w * sp_scale, 1e-4);
    sp_base = mat3(sp_M * sp_p + sp_T, sp_rgba.rgb, vec3(sp_rgba.a, 1.0, 0.0));
    vec2 g_uv = vec2(0.0);
    vec2 splatModUv = vec2(0.5);
    // LFO: a slow sine from 0 to 1, once every eight seconds.
    // Why: wired into Explode's Amount socket, it blows the scan apart and brings it home again, over and over.
    float lfo_0_value = sin(u_time * u_p_lfox0_freq * 6.2831853 + u_p_lfox0_phase) * u_p_lfox0_amplitude + u_p_lfox0_offset;
    // Splat Attributes: one splat as numbers. "In the scan" is where it sits in the scan (scene units, +Y up), so whatever reads it sticks to the scan as it turns; Color is its own colour.
    // Why: the start of a chain of ordinary nodes that runs once for every splat.
    mat3 splatattri_0_i = sp_base;
    // Colour by height (an Expression Block): blue at the bottom of the scan, orange at the top, mixed 60/40 with each splat's own colour.
    // h: the splat's height in the scan (y), from about −0.85 to 0.85, turned into 0–1.
    // Result: a blue→orange ramp by h, mixed over the splat's colour c by 0.6. Try: 1.0 instead of 0.6 for the pure ramp.
    vec3 colour_by_height_0_result;
    {
        vec3 p = sp_local;
        vec3 c = splatattri_0_i[1];
        float t = u_time;
        float h = clamp(p.y * 0.6 + 0.5, 0.0, 1.0);
        colour_by_height_0_result = mix(c, mix(vec3(0.15, 0.45, 1.0), vec3(1.0, 0.45, 0.15), h), 0.6);
    }
    // Set Splat: the Expression Block's colour becomes the splat's colour. Its other sockets are unwired, so position, opacity and size stay as they were.
    mat3 splatset_0_i = sp_base;
    vec3 splatset_0_p = splatset_0_i[0];
    vec3 splatset_0_c = colour_by_height_0_result;
    vec3 splatset_0_l = vec3(splatset_0_i[2].x, splatset_0_i[2].y, splatset_0_i[2].z);
    float splatset_0_k = clamp(u_p_splatsetx0_amount, 0.0, 1.0);
    mat3 splatset_0_s = mat3(mix(splatset_0_i[0], splatset_0_p, splatset_0_k), mix(splatset_0_i[1], splatset_0_c, splatset_0_k), mix(splatset_0_i[2], splatset_0_l, splatset_0_k));
    // Splat Explode: blows the splats out from the centre (each a little after the last: Stagger 0.6), turning as they go (Spin).
    // Its Amount comes from the LFO (the socket beside the slider). The engine sorts the splats by where they have moved to, so they still blend far to near.
    mat3 splatexplo_0_i = splatset_0_s;
    vec3 splatexplo_0_c = u_p_splatexplox0_center;
    float splatexplo_0_r = sp_rand;
    float splatexplo_0_st = clamp(u_p_splatexplox0_stagger, 0.0, 1.0);
    float splatexplo_0_out = smoothstep(0.0, 1.0, clamp(clamp(lfo_0_value, 0.0, 1.0) * (1.0 + splatexplo_0_st) - splatexplo_0_r * splatexplo_0_st, 0.0, 1.0));
    float splatexplo_0_home = smoothstep(0.0, 1.0, clamp(clamp(u_p_splatexplox0_returnHome, 0.0, 1.0) * (1.0 + splatexplo_0_st) - (1.0 - splatexplo_0_r) * splatexplo_0_st, 0.0, 1.0));
    float splatexplo_0_k = splatexplo_0_out * (1.0 - splatexplo_0_home);
    vec3 splatexplo_0_rel = splatexplo_0_i[0] - splatexplo_0_c;
    vec3 splatexplo_0_rnd = vec3(spHash31(vec3(splatexplo_0_r * 113.1, splatexplo_0_r * 71.7, 1.3)), spHash31(vec3(splatexplo_0_r * 57.3, 2.9, splatexplo_0_r * 91.1)), spHash31(vec3(3.7, splatexplo_0_r * 37.9, splatexplo_0_r * 19.3))) * 2.0 - 1.0;
    vec3 splatexplo_0_dir = normalize(mix(splatexplo_0_rel / max(length(splatexplo_0_rel), 1e-4), splatexplo_0_rnd / max(length(splatexplo_0_rnd), 1e-4), clamp(u_p_splatexplox0_scatter, 0.0, 1.0)) + vec3(1e-5));
    vec3 splatexplo_0_moved = splatexplo_0_rel + splatexplo_0_dir * (u_p_splatexplox0_distance * splatexplo_0_k * (0.6 + 0.8 * fract(splatexplo_0_r * 7.31)));
    mat3 splatexplo_0_s = splatexplo_0_i;
    splatexplo_0_s[0] = splatexplo_0_c + spRotY(u_p_splatexplox0_spin * 6.2831853 * splatexplo_0_k) * splatexplo_0_moved;
    // Splat Wave, Wobble: every splat drifts a little through slow noise, so the surface shimmers even at rest.
    // Try: Kind Wave and Amplitude 0.08 for ripples running across the scan; Twist for a spiral.
    mat3 splatwave_0_i = splatexplo_0_s;
    mat3 splatwave_0_s = splatwave_0_i;
    splatwave_0_s[0] += (spNoise33(sp_local * u_p_splatwavex0_frequency + vec3((u_time * u_p_splatwavex0_speed), (u_time * u_p_splatwavex0_speed) * 0.83, (u_time * u_p_splatwavex0_speed) * 0.61)) * 2.0 - 1.0) * u_p_splatwavex0_amplitude;
    mat3 splatmodou_0_s = splatwave_0_s;
    float splatmodou_0_size = max(splatmodou_0_s[2].y, 0.0);
    float splatmodou_0_enc = splatmodou_0_s[2].z > 0.0 ? -max(splatmodou_0_s[2].z * splatmodou_0_size, 0.25) : splatmodou_0_size;
    gl_FragColor = vec4(splatmodou_0_s[0], splatmodou_0_enc);
    splatModOut1 = vec4(max(splatmodou_0_s[1], 0.0), clamp(splatmodou_0_s[2].x, 0.0, 4.0));
}",
        "liveUniforms": {},
        "moves": {
          "always": true,
          "gates": [
            "u_p_splatwavex0_amplitude",
          ],
        },
        "nodeId": "smScan",
        "paramBindings": {
          "smExplode::center": "u_p_splatexplox0_center",
          "smExplode::distance": "u_p_splatexplox0_distance",
          "smExplode::returnHome": "u_p_splatexplox0_returnHome",
