    vec2 g_uv = (vUv - 0.5) * 2.0;
    g_uv.x *= u_resolution.x / u_resolution.y;
    // Time: the clock, in seconds.
    float time_0_time = u_time;
    // Time × 10: the scan's turn in degrees, 10 a second.
    // Why: turning shows the scan (and what the modifiers do to it) from every side.
    float mul_0_result = time_0_time * u_p_mulx0_b;
    // Make Vec3: the turn as the Splat Scene's Rotation (X, Y, Z in degrees): only Y moves.
    vec3 mkv3_0_rgb = vec3(u_p_mkv3x0_r, mul_0_result, u_p_mkv3x0_b);
    // Splat Scene: a generated scan (a lumpy ball of 150 000 splats; drop a .ply, .splat or .spz here for a real one).
    // Its Modifier takes the chain: Set Splat → Explode → Wave, applied in that order to every splat before it is drawn.
    // Unwired Ray Origin / Ray Dir: a camera 3 back, looking at the middle.
    // splat-scene u_tex_splat_0_color
    vec4 splat_0_c = texture2D(u_tex_splat_0_color, vUv);
    vec4 splat_0_d = texture2D(u_tex_splat_0_depth, vUv);
    float splat_0_a = clamp(splat_0_c.a, 0.0, 1.0);
    float splat_0_sd = splat_0_d.a > 1e-4 ? splat_0_d.r / splat_0_d.a : 100000.0;
    float splat_0_sh = step(u_p_splatx0_hitAt, splat_0_a);
    gl_FragColor = vec4(splat_0_c.rgb, 1.0);
}",
  "paramUniforms": {
    "u_p_lfox0_amplitude": 0.5,
    "u_p_lfox0_freq": 0.12,
    "u_p_lfox0_offset": 0.5,
    "u_p_lfox0_phase": 0,
    "u_p_mkv3x0_b": 0,
    "u_p_mkv3x0_g": 0,
    "u_p_mkv3x0_r": 0,
    "u_p_mulx0_b": 10,
    "u_p_splatexplox0_center": [
      0,
      0,
      0,
    ],
    "u_p_splatexplox0_distance": 1.1,
    "u_p_splatexplox0_returnHome": 0,
    "u_p_splatexplox0_scatter": 0.45,
    "u_p_splatexplox0_spin": 0.35,
    "u_p_splatexplox0_stagger": 0.6,
    "u_p_splatsetx0_amount": 1,
