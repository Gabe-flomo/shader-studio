      "style": "glow",
    },
  ],
  "errors": null,
  "fragmentShader": "precision highp float;
#define PI 3.1415926538
#define TAU 6.2831853072

uniform vec2 u_resolution;
uniform float u_time;
uniform vec2 u_mouse;
uniform sampler2D u_fontTexture;
uniform float u_p_trailfieldx3_diffuse;
uniform float u_p_trailfieldx3_halfLife;
uniform float u_p_trailfieldx3_gain;
uniform float u_p_drawagentsx3_size;
uniform float u_p_drawagentsx3_brightness;
uniform float u_p_drawagentsx3_glow;
uniform vec3 u_p_drawagentsx3_colorA;
uniform vec3 u_p_drawagentsx3_colorB;
uniform float u_p_drawagentsx3_speedRef;
uniform float u_p_drawagentsx3_camDist;
uniform float u_p_drawagentsx3_camAngle;
uniform float u_p_drawagentsx3_camElevation;
uniform float u_p_drawagentsx3_rotSpeed;
uniform float u_p_drawagentsx3_fov;
uniform float u_p_drawagentsx3_ortho;
uniform float u_p_drawagentsx3_camX;
uniform float u_p_drawagentsx3_camY;
uniform float u_p_drawagentsx3_camZ;
uniform float u_p_drawagentsx3_drift;
uniform float u_p_drawagentsx3_focus;
uniform float u_p_drawagentsx3_blur;
uniform float u_p_drawagentsx3_maxBlur;
uniform sampler2D u_trail_trailfield_3;
uniform vec2 u_trail_trailfield_3_px;
uniform sampler2D u_agdraw_drawagents_3;
uniform vec2 u_agdraw_drawagents_3_px;

varying vec2 vUv;

// ── Always-available helpers (noise, rotation) ───────────────────────────────
vec2 noiseHash2(vec2 p) {
    p = vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)));
    return -1.0 + 2.0 * fract(sin(p) * 43758.5453123);
}
float noiseHash1(vec2 p) {
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
}
float valueNoise(vec2 p) {
    vec2 i = floor(p); vec2 f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(noiseHash1(i), noiseHash1(i+vec2(1,0)), u.x),
               mix(noiseHash1(i+vec2(0,1)), noiseHash1(i+vec2(1,1)), u.x), u.y);
}
vec2 rotate(vec2 v, float angle) {
    // Hoisted: the angle is usually a uniform expression, and the compiler
    // can't share the four trig calls when the argument isn't a plain value.
    float s = sin(angle), c = cos(angle);
    return vec2(v.x * c - v.y * s, v.x * s + v.y * c);
}
mat2 rot2D(float a) { float s=sin(a), c=cos(a); return mat2(c,-s,s,c); }
// ─────────────────────────────────────────────────────────────────────────

vec2 agUv(vec2 q) { return q / vec2(u_resolution.x / u_resolution.y, 1.0) * 0.5 + 0.5; }

void main() {
    vec2 g_uv = (vUv - 0.5) * 2.0;
    g_uv.x *= u_resolution.x / u_resolution.y;
    // Trail field, filled by a 3D group: a volume, 96 rows tall and 96 slices deep (171 cells across at 16:9). Each step every cell becomes the average of itself and its 6 neighbours, and half fades in 0.1 s.
    // Its Texture goes back into the group for Sense, read in 3D. Its Amount here would be the volume seen from the front; this example shows the walkers through a camera instead.
    // Try: Volume 128 for finer tubes (more memory and time), 64 for a fast, coarse one; Half-life 0.3 for thicker, slower tubes.
    vec4 trailfield_3_t = texture2D(u_trail_trailfield_3, agUv(g_uv));
    // Draw agents in 3D: every walker as a soft glowing dot, coloured by heading (amber one way, blue the other), seen through a camera 3.8 from the middle that circles the box at 6° a second, 15° above it.
    // Blur 0.2 with Focus 1: the middle of the box is sharp, the near and far walkers a little soft, which makes the depth read.
    // Try: Flatten 1 for an isometric view; Orbit speed 0 and drag Angle to look from the side; Elevation 89 to look straight down.
    vec4 drawagents_3_s = texture2D(u_agdraw_drawagents_3, agUv(g_uv));
    vec3 drawagents_3_color = vec3(0.0) + max(drawagents_3_s.rgb, vec3(0.0));
    // Output: the walkers, drawn through the camera over the night backdrop, are the picture.
    gl_FragColor = vec4(drawagents_3_color, 1.0);
}",
