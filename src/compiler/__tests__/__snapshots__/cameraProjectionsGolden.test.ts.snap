exports[`camera projections: defaults compile as before > Splat builder's starting scene 1`] = `
{
  "draws": [],
  "errors": null,
  "fragmentShader": "precision highp float;
#define PI 3.1415926538
#define TAU 6.2831853072

uniform vec2 u_resolution;
uniform float u_time;
uniform vec2 u_mouse;
uniform sampler2D u_fontTexture;
uniform float u_p_marchcamerx0_camDist;
uniform float u_p_marchcamerx0_camAngle;
uniform float u_p_marchcamerx0_camElevation;
uniform float u_p_marchcamerx0_rotSpeed;
uniform float u_p_marchcamerx0_fov;
uniform float u_p_marchcamerx0_targetX;
uniform float u_p_marchcamerx0_targetY;
uniform float u_p_marchcamerx0_targetZ;
uniform float u_p_marchcamerx0_aperture;
uniform float u_p_marchcamerx0_focalDist;
uniform float u_p_marchcamerx0_lensSpeed;
uniform vec3 u_p_colorpickex0_color;
uniform vec3 u_p_colorpickex0xc2_color;
uniform vec3 u_p_gradx0_color_a;
uniform vec3 u_p_gradx0_color_b;
uniform float u_p_gradx0_t_offset;
uniform vec3 u_p_splatx0_position;
uniform vec3 u_p_splatx0_rotation;
uniform float u_p_splatx0_scale;
uniform float u_p_splatx0_splatSize;
uniform float u_p_splatx0_opacity;
uniform float u_p_splatx0_softness;
uniform float u_p_splatx0_hitAt;
uniform sampler2D u_tex_splat_0_color;
uniform sampler2D u_tex_splat_0_depth;

varying vec2 vUv;

// ── Always-available helpers (noise, rotation) ───────────────────────────────
vec2 noiseHash2(vec2 p) {
    p = vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)));
    return -1.0 + 2.0 * fract(sin(p) * 43758.5453123);
}
float noiseHash1(vec2 p) {
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
}
float valueNoise(vec2 p) {
    vec2 i = floor(p); vec2 f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(noiseHash1(i), noiseHash1(i+vec2(1,0)), u.x),
               mix(noiseHash1(i+vec2(0,1)), noiseHash1(i+vec2(1,1)), u.x), u.y);
}
vec2 rotate(vec2 v, float angle) {
    // Hoisted: the angle is usually a uniform expression, and the compiler
    // can't share the four trig calls when the argument isn't a plain value.
    float s = sin(angle), c = cos(angle);
    return vec2(v.x * c - v.y * s, v.x * s + v.y * c);
}
mat2 rot2D(float a) { float s=sin(a), c=cos(a); return mat2(c,-s,s,c); }
// ─────────────────────────────────────────────────────────────────────────

vec3 gradientBlend(vec2 uv, vec3 colorA, vec3 colorB, int mode, float offset) {
    float t;
    if (mode == 0) { t = uv.x * 0.5 + 0.5; }
    else if (mode == 1) { t = uv.y * 0.5 + 0.5; }
    else if (mode == 2) { t = length(uv); }
    // Angular, seamless: the angle up from the bottom on either side (left half mirrors the right),
    // so it runs Color A at the bottom to Color B at the top with no jump where atan wraps at ±π.
    else if (mode == 3) { t = atan(uv.y, abs(uv.x)) / 3.14159265 + 0.5; }
    // Angular, wrap: one full turn, 0 → 1, with a hard seam on the left where the angle wraps.
    else if (mode == 5) { t = atan(uv.y, uv.x) / 6.28318 + 0.5; }
    else { t = (uv.x + uv.y) * 0.5 * 0.7071 + 0.5; }
    return mix(colorA, colorB, clamp(t + offset, 0.0, 1.0));
}

void main() {
    vec2 g_uv = (vUv - 0.5) * 2.0;
    g_uv.x *= u_resolution.x / u_resolution.y;
    // The camera: it turns round the scan (Angle, Elevation) at Distance, looking at Target. Every pixel becomes a ray from here; the Splat Scene draws the scan through the same camera.
    float marchcamer_0_ang   = u_p_marchcamerx0_camAngle + u_time * u_p_marchcamerx0_rotSpeed;
    float marchcamer_0_elev  = u_p_marchcamerx0_camElevation;
    vec3  marchcamer_0_ta    = vec3(u_p_marchcamerx0_targetX, u_p_marchcamerx0_targetY, u_p_marchcamerx0_targetZ);
    vec3  marchcamer_0_horiz = vec3(sin(marchcamer_0_ang), 0.0, cos(marchcamer_0_ang));
    vec3  marchcamer_0_ro0   = marchcamer_0_ta + u_p_marchcamerx0_camDist * (cos(marchcamer_0_elev)*marchcamer_0_horiz + sin(marchcamer_0_elev)*vec3(0.0,1.0,0.0));
    vec3  marchcamer_0_fwd   = normalize(marchcamer_0_ta - marchcamer_0_ro0);
    vec3  marchcamer_0_cup   = normalize(-sin(marchcamer_0_elev)*marchcamer_0_horiz + cos(marchcamer_0_elev)*vec3(0.0,1.0,0.0));
    vec3  marchcamer_0_rgt   = normalize(cross(marchcamer_0_cup, marchcamer_0_fwd));
    vec3  marchcamer_0_up2   = cross(marchcamer_0_fwd, marchcamer_0_rgt);
    vec3  marchcamer_0_rd0   = normalize(g_uv.x * marchcamer_0_rgt + g_uv.y * marchcamer_0_up2 + u_p_marchcamerx0_fov * marchcamer_0_fwd);
    float marchcamer_0_h1    = fract(sin(dot(g_uv, vec2(127.1, 311.7))) * 43758.5453);
    float marchcamer_0_h2    = fract(sin(dot(g_uv, vec2(269.5, 183.3))) * 43758.5453);
    float marchcamer_0_lr    = min(u_p_marchcamerx0_aperture, 0.06 * max(u_p_marchcamerx0_focalDist, 0.05)) * sqrt(marchcamer_0_h1);
    float marchcamer_0_lth   = 6.28318 * marchcamer_0_h2 + u_time * u_p_marchcamerx0_lensSpeed;
    vec3  marchcamer_0_ro    = marchcamer_0_ro0 + marchcamer_0_lr * (cos(marchcamer_0_lth) * marchcamer_0_rgt + sin(marchcamer_0_lth) * marchcamer_0_up2);
    vec3  marchcamer_0_rd    = normalize((marchcamer_0_ro0 + marchcamer_0_rd0 * max(u_p_marchcamerx0_focalDist, 0.05)) - marchcamer_0_ro);
    // The top of the background gradient (looking up).
    vec3 colorpicke_0_rgb = u_p_colorpickex0_color;
    float colorpicke_0_r = colorpicke_0_rgb.x;
    float colorpicke_0_g = colorpicke_0_rgb.y;
    float colorpicke_0_b = colorpicke_0_rgb.z;
    // The bottom of the background gradient (looking down).
    vec3 colorpicke_0_c2_rgb = u_p_colorpickex0xc2_color;
    float colorpicke_0_c2_r = colorpicke_0_c2_rgb.x;
    float colorpicke_0_c2_g = colorpicke_0_c2_rgb.y;
    float colorpicke_0_c2_b = colorpicke_0_c2_rgb.z;
    // The background (Gradient, Linear Y on the camera's Ray Dir): by which way each ray points, from Bottom (straight down) to Top (straight up). It turns with the camera.
    vec3 grad_0_color = gradientBlend(g_uv, colorpicke_0_c2_rgb, colorpicke_0_rgb, 1, u_p_gradx0_t_offset);
    // Splat Scene: a generated example scan (no file). Load your own in the Splat builder's Scan section, or drop a .ply, .splat or .spz on this card.
    // Seen through the March Camera, so it sits in the same space as the background.
    // Made by the Splat builder: right-click → Edit in Splat builder, or open the Scene builder and pick Edit this one.
    // splat-scene u_tex_splat_0_color
    vec4 splat_0_c = texture2D(u_tex_splat_0_color, vUv);
    vec4 splat_0_d = texture2D(u_tex_splat_0_depth, vUv);
    float splat_0_a = clamp(splat_0_c.a, 0.0, 1.0);
    float splat_0_sd = splat_0_d.a > 1e-4 ? splat_0_d.r / splat_0_d.a : 100000.0;
    float splat_0_sh = step(u_p_splatx0_hitAt, splat_0_a);
    float splat_0_sceneHit = step(0.5, 1.0);
    float splat_0_sceneD = mix(100000.0, 100000.0, splat_0_sceneHit);
    float splat_0_soft = max(u_p_splatx0_softness, 1e-4);
    float splat_0_front = smoothstep(-splat_0_soft, splat_0_soft, splat_0_sd - splat_0_sceneD) * splat_0_sceneHit;
    vec3 splat_0_over = splat_0_c.rgb + (1.0 - splat_0_a) * grad_0_color;
    vec3 splat_0_col = mix(splat_0_over, grad_0_color, splat_0_front);
    gl_FragColor = vec4(splat_0_col, 1.0);
}",
