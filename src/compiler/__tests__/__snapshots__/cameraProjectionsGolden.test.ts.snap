        if (marchloopg_0_d < 0.0005) { marchloopg_0_hit = 1.0; marchloopg_0_si = marchloopg_0_i; break; }
        marchloopg_0_t += marchloopg_0_d * u_p_marchloopgx0_stepScale;
        if (marchloopg_0_t > u_p_marchloopgx0_maxDist) { marchloopg_0_si = marchloopg_0_i; break; }
    }
    float marchloopg_0_iter      = float(marchloopg_0_si) / float(80);
    float marchloopg_0_iterCount = float(marchloopg_0_si);
    vec3  marchloopg_0_hp_raw  = marchcamer_0_ro + marchloopg_0_t * marchcamer_0_rd;
    vec3  marchloopg_0_hp  = marchBody_marchloopg_0(marchloopg_0_hp_raw, marchloopg_0_t, marchcamer_0_ro, marchcamer_0_rd);
    float marchloopg_0_e   = 0.001;
    vec3  marchloopg_0_n   = normalize(vec3(
        mapScene_torus_0(marchBody_marchloopg_0(marchloopg_0_hp_raw+vec3(marchloopg_0_e,0.0,0.0), marchloopg_0_t, marchcamer_0_ro, marchcamer_0_rd)) - mapScene_torus_0(marchBody_marchloopg_0(marchloopg_0_hp_raw-vec3(marchloopg_0_e,0.0,0.0), marchloopg_0_t, marchcamer_0_ro, marchcamer_0_rd)),
        mapScene_torus_0(marchBody_marchloopg_0(marchloopg_0_hp_raw+vec3(0.0,marchloopg_0_e,0.0), marchloopg_0_t, marchcamer_0_ro, marchcamer_0_rd)) - mapScene_torus_0(marchBody_marchloopg_0(marchloopg_0_hp_raw-vec3(0.0,marchloopg_0_e,0.0), marchloopg_0_t, marchcamer_0_ro, marchcamer_0_rd)),
        mapScene_torus_0(marchBody_marchloopg_0(marchloopg_0_hp_raw+vec3(0.0,0.0,marchloopg_0_e), marchloopg_0_t, marchcamer_0_ro, marchcamer_0_rd)) - mapScene_torus_0(marchBody_marchloopg_0(marchloopg_0_hp_raw-vec3(0.0,0.0,marchloopg_0_e), marchloopg_0_t, marchcamer_0_ro, marchcamer_0_rd))
    ));
    float marchloopg_0_dist   = marchloopg_0_t;
    float marchloopg_0_depth  = clamp(marchloopg_0_t / u_p_marchloopgx0_maxDist, 0.0, 1.0);
    vec3  marchloopg_0_normal = marchloopg_0_n * marchloopg_0_hit;
    vec3  marchloopg_0_bg     = u_p_marchloopgx0_bg;
    vec3  marchloopg_0_ld     = normalize(vec3(1.5, 2.0, 1.0));
    float marchloopg_0_diff   = max(0.0, dot(marchloopg_0_n, marchloopg_0_ld));
    vec3  marchloopg_0_alb    = u_p_marchloopgx0_albedo;
    vec3  marchloopg_0_color  = marchloopg_0_hit > 0.5 ? marchloopg_0_alb * (0.15 + 0.85 * marchloopg_0_diff) : marchloopg_0_bg;
    // Multi-Light: the torus lit by a sun from above and a faint blue sky; misses (Hit 0) stay black.
    vec3 multilight_0_color = marchloopg_0_hit > 0.5 ? multiLight(colorpicke_0_rgb, marchloopg_0_normal, 1.0, 1.0, vec3(u_p_multilightx0_sunDirX, u_p_multilightx0_sunDirY, u_p_multilightx0_sunDirZ), vec3(u_p_multilightx0_sunR, u_p_multilightx0_sunG, u_p_multilightx0_sunB), vec3(u_p_multilightx0_skyR, u_p_multilightx0_skyG, u_p_multilightx0_skyB), vec3(u_p_multilightx0_bounceR, u_p_multilightx0_bounceG, u_p_multilightx0_bounceB)) : vec3(0.0);
    // Tone Map: keeps the lit torus from clipping; its colour is what the swarm is drawn over.
    vec3 tone_0_color = toneACES(multilight_0_color);
    // Draw agents in 3D through the scene's camera: Camera from and Camera ray are the March Camera's, so the swarm stands in the scene; Depth is the March Loop's Distance, so walkers behind the torus are hidden.
    // Colour by Speed, fast first, on the Ice palette: the fast ones whipping through the hole pale, the slower ones deep blue. Blur 0.25 softens the near and far ones.
    // Try: unwire Depth to see the walkers behind the torus too.
    vec4 drawagents_0_s = texture2D(u_agdraw_drawagents_0, agUv(g_uv));
    vec3 drawagents_0_color = tone_0_color + max(drawagents_0_s.rgb, vec3(0.0));
    // Output: the swarm drawn into the lit torus scene is the picture.
    gl_FragColor = vec4(drawagents_0_color, 1.0);
}",
