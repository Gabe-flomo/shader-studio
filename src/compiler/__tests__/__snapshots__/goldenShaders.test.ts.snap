    "u_p_piecesx0_scatterSize",
    "u_p_piecesx0_scatterTurn",
    "u_p_piecesx0_search",
    "u_p_piecesx0_seed",
    "u_p_piecesx0_shading",
    "u_p_piecesx0_size",
    "u_p_piecesx0_softness",
    "u_p_piecesx0_spin",
    "u_p_piecesx0_stagger",
    "u_p_piecesx0_turn",
    "u_p_scatterx0_burst",
    "u_p_scatterx0_rest",
  ],
  "paramValues": "16824c5f6c078b154d51bd4766e6:703",
  "passes": [
    {
      "filter": "linear",
      "format": "half",
      "fragmentShader": "precision highp float;
#define PI 3.1415926538
#define TAU 6.2831853072

uniform vec2 u_resolution;
uniform float u_time;
uniform vec2 u_mouse;
uniform sampler2D u_fontTexture;

varying vec2 vUv;

// ── Always-available helpers (noise, rotation) ───────────────────────────────
vec2 noiseHash2(vec2 p) {
    p = vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)));
    return -1.0 + 2.0 * fract(sin(p) * 43758.5453123);
}
float noiseHash1(vec2 p) {
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
}
float valueNoise(vec2 p) {
    vec2 i = floor(p); vec2 f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(noiseHash1(i), noiseHash1(i+vec2(1,0)), u.x),
               mix(noiseHash1(i+vec2(0,1)), noiseHash1(i+vec2(1,1)), u.x), u.y);
}
vec2 rotate(vec2 v, float angle) {
    // Hoisted: the angle is usually a uniform expression, and the compiler
    // can't share the four trig calls when the argument isn't a plain value.
    float s = sin(angle), c = cos(angle);
    return vec2(v.x * c - v.y * s, v.x * s + v.y * c);
}
mat2 rot2D(float a) { float s=sin(a), c=cos(a); return mat2(c,-s,s,c); }
// ─────────────────────────────────────────────────────────────────────────



void main() {
    vec2 g_uv = (vUv - 0.5) * 2.0;
    g_uv.x *= u_resolution.x / u_resolution.y;
    // Time: turns the rings.
    float time_0_c2_time = u_time;
    // UV inside the Shader Texture: its own square, −1 to 1.
    vec2 uv_0_c2_uv = (vUv - 0.5) * 2.0;
    uv_0_c2_uv.x *= u_resolution.x / u_resolution.y;
    // Kaleidoscope: the angle folded into six mirrored wedges, rings rolling out (bent by a wave), crossed by petals. The colour runs gold, ember and sky blue with the pattern and the radius (h), drifting slowly; dark between the bands.
    // Kept below 1 (× 0.85) so the glowing balls brighten it without washing out to white; faded out past the edge.
    vec3 kaleidoscope_0_result;
    {
        vec2 p = uv_0_c2_uv;
        float t = time_0_c2_time;
        float r = length(p);
        float a = abs(mod(atan(p.x, p.y) + t * 0.05, 1.0471976) - 0.5235988);
        vec2 q = r * vec2(cos(a), sin(a));
        float rings = sin(r * 11.0 - t * 0.9 + 1.6 * sin(q.y * 7.0 + t * 0.3));
        float petals = sin(q.x * 8.0 + t * 0.5) * sin(q.y * 13.0 - t * 0.4);
        float v = rings + 0.6 * petals;
        float h = fract(0.18 * v + 0.55 * r - 0.02 * t);
        vec3 gold = vec3(1.0, 0.68, 0.16);
        vec3 ember = vec3(0.95, 0.28, 0.06);
        vec3 sky = vec3(0.12, 0.5, 1.0);
        vec3 hue = h < 0.33 ? gold + (ember - gold) * (h * 3.0) : h < 0.66 ? ember + (sky - ember) * (h * 3.0 - 1.0) : sky + (gold - sky) * (h * 3.0 - 2.0);
        kaleidoscope_0_result = hue * 0.85 * smoothstep(-0.2, 0.8, v) * (1.0 - smoothstep(0.85, 1.4, r));
    }
    gl_FragColor = vec4(kaleidoscope_0_result, 1.0);
}",
      "label": "Kaleidoscope",
      "live": true,
      "nodeId": "kal",
      "nodeIds": [
        "kRings",
        "kTime",
        "kUv",
      ],
      "previous": false,
      "reads": [],
      "readsPrevious": [],
      "scale": 1,
      "size": 1024,
      "slug": "kaleidoscope_0_c2",
      "wrap": "clamp",
    },
  ],
  "success": true,
  "textureUniforms": {},
  "vertexShader": "1ddaa7d0b3c1631ea3c930991808:87",
  "videoUniforms": {},
}
`;

