vec3 blKeep(vec3 c, float thr, float knee) { return c * smoothstep(thr, thr + max(knee, 1e-4), dot(c, vec3(0.299, 0.587, 0.114))); }


vec4 blKeep4(vec4 c, float thr, float knee) { return vec4(blKeep(c.rgb, thr, knee), c.a); }


float blKarisW(vec4 c) { return 1.0 / (1.0 + dot(c.rgb, vec3(0.299, 0.587, 0.114))); }








vec4 blDown13Keep(sampler2D s, vec2 uv, vec2 t, float thr, float knee) {
  vec4 a = blKeep4(texture2D(s, uv + t * vec2(-2.0, 2.0)), thr, knee);
  vec4 b = blKeep4(texture2D(s, uv + t * vec2(0.0, 2.0)), thr, knee);
  vec4 c = blKeep4(texture2D(s, uv + t * vec2(2.0, 2.0)), thr, knee);
  vec4 d = blKeep4(texture2D(s, uv + t * vec2(-2.0, 0.0)), thr, knee);
  vec4 e = blKeep4(texture2D(s, uv), thr, knee);
  vec4 f = blKeep4(texture2D(s, uv + t * vec2(2.0, 0.0)), thr, knee);
  vec4 g = blKeep4(texture2D(s, uv + t * vec2(-2.0, -2.0)), thr, knee);
  vec4 h = blKeep4(texture2D(s, uv + t * vec2(0.0, -2.0)), thr, knee);
  vec4 i = blKeep4(texture2D(s, uv + t * vec2(2.0, -2.0)), thr, knee);
  vec4 j = blKeep4(texture2D(s, uv + t * vec2(-1.0, 1.0)), thr, knee);
  vec4 k = blKeep4(texture2D(s, uv + t * vec2(1.0, 1.0)), thr, knee);
  vec4 l = blKeep4(texture2D(s, uv + t * vec2(-1.0, -1.0)), thr, knee);
  vec4 m = blKeep4(texture2D(s, uv + t * vec2(1.0, -1.0)), thr, knee);
  // Karis average (Jimenez 2014): each of the five 2×2 boxes weighed by 1 / (1 + luma), so one blazing texel can't flicker.
  vec4 b0 = (j + k + l + m) * 0.25, b1 = (a + b + d + e) * 0.25, b2 = (b + c + e + f) * 0.25, b3 = (d + e + g + h) * 0.25, b4 = (e + f + h + i) * 0.25;
  float w0 = 0.5 * blKarisW(b0), w1 = 0.125 * blKarisW(b1), w2 = 0.125 * blKarisW(b2), w3 = 0.125 * blKarisW(b3), w4 = 0.125 * blKarisW(b4);
  return (b0 * w0 + b1 * w1 + b2 * w2 + b3 * w3 + b4 * w4) / (w0 + w1 + w2 + w3 + w4);
}











void main() {
