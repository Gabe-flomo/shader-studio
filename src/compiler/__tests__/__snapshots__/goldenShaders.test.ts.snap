    // Hoisted: the angle is usually a uniform expression, and the compiler
    // can't share the four trig calls when the argument isn't a plain value.
    float s = sin(angle), c = cos(angle);
    return vec2(v.x * c - v.y * s, v.x * s + v.y * c);
}
mat2 rot2D(float a) { float s=sin(a), c=cos(a); return mat2(c,-s,s,c); }
// ─────────────────────────────────────────────────────────────────────────











vec4 blTent(sampler2D s, vec2 uv, vec2 t) {
  vec4 r = texture2D(s, uv) * 4.0;
  r += (texture2D(s, uv + vec2(t.x, 0.0)) + texture2D(s, uv - vec2(t.x, 0.0)) + texture2D(s, uv + vec2(0.0, t.y)) + texture2D(s, uv - vec2(0.0, t.y))) * 2.0;
  r += texture2D(s, uv + t) + texture2D(s, uv - t) + texture2D(s, uv + vec2(t.x, -t.y)) + texture2D(s, uv + vec2(-t.x, t.y));
  return r / 16.0;
}








float blBloomW(float radius, float srcScale, float k) {
  if (k <= 1.0) return 1.0;
  return clamp(log2(max(radius, 1.0) * srcScale / 4.0) - k + 2.0, 0.0, 1.0);
}




float blBloomWt(float radius, float srcScale, float k, float tail) {
  return blBloomW(radius, srcScale, k) * (1.0 + max(tail, 0.0) * (k - 1.0));
}



void main() {
    vec2 g_uv = (vUv - 0.5) * 2.0;
    g_uv.x *= u_resolution.x / u_resolution.y;
    // Glow (texture): the bright on cells, spread into a soft light (a bloom chain on the board's Texture).
    vec4 tglow_0_o = texture2D(u_pass_tglow_0Bld1, vUv) * blBloomWt(u_p_tglowx0_radius, 1.0, 1.0, u_p_tglowx0_tail) + blTent(u_pass_tglow_0Blu2, vUv, (u_pass_tglow_0Blu2_px / 0.25));
    gl_FragColor = vec4(tglow_0_o.rgb, tglow_0_o.a);
