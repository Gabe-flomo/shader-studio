  "passes": [
    {
      "filter": "nearest",
      "format": "float",
      "fragmentShader": "precision highp float;
#define PI 3.1415926538
#define TAU 6.2831853072

uniform vec2 u_resolution;
uniform float u_time;
uniform vec2 u_mouse;
uniform sampler2D u_fontTexture;
uniform float u_aud_audiosourc_0_level;
uniform float u_aud_audiosourc_0_time;
uniform float u_aud_audiosourc_0_kick_t;
uniform float u_aud_audiosourc_0_bass_v;
uniform sampler2D u_pass_memory_0;
uniform vec2 u_pass_memory_0_px;
uniform sampler2D u_passprev_memory_0;
uniform vec2 u_passprev_memory_0_px;
uniform float u_frameDt;

varying vec2 vUv;

// ── Always-available helpers (noise, rotation) ───────────────────────────────
vec2 noiseHash2(vec2 p) {
    p = vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)));
    return -1.0 + 2.0 * fract(sin(p) * 43758.5453123);
}
float noiseHash1(vec2 p) {
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
}
float valueNoise(vec2 p) {
    vec2 i = floor(p); vec2 f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(noiseHash1(i), noiseHash1(i+vec2(1,0)), u.x),
               mix(noiseHash1(i+vec2(0,1)), noiseHash1(i+vec2(1,1)), u.x), u.y);
}
vec2 rotate(vec2 v, float angle) {
    // Hoisted: the angle is usually a uniform expression, and the compiler
    // can't share the four trig calls when the argument isn't a plain value.
    float s = sin(angle), c = cos(angle);
    return vec2(v.x * c - v.y * s, v.x * s + v.y * c);
}
mat2 rot2D(float a) { float s=sin(a), c=cos(a); return mat2(c,-s,s,c); }
// ─────────────────────────────────────────────────────────────────────────



void main() {
    vec2 g_uv = (vUv - 0.5) * 2.0;
    g_uv.x *= u_resolution.x / u_resolution.y;
    // Audio Source: opens on the File tab with nothing loaded, so the picture waits in silence. Press Load a sound… on the card and pick any song, or switch to the Mic tab and press Start.
    // Open ↗ on the card shows the whole file to trim (it loops inside the trim) and a live spectrum to pick bands on. If you hear nothing, click anywhere: browsers start sound only after a click.
    // Two bands, picked on Open ↗: Kick (30–150 Hz) sends a trigger, 1 for one frame on each kick drum (Cooldown stops one kick counting twice); Bass (60–250 Hz) sends its level, 0–1.
    // Each band is an output here: Kick (trigger) and Bass. Add more with the quick bands (Snare, Hi-hat…) or by dragging across the spectrum.
    int memorypack_0_i = int(floor(gl_FragCoord.x));
    vec4 memorypack_0_s = texelFetch(u_passprev_memory_0, ivec2(memorypack_0_i, 0), 0);
    float memorypack_0_dt = max(u_frameDt, 0.0);
    if (memorypack_0_i == 0) {
      vec4 s = memorypack_0_s; float dt = memorypack_0_dt;
      if (s.w < 0.5) { s = vec4(0.0, 0.0, 0.0, 1.0); } else {
        float gt = step(0.5, u_aud_audiosourc_0_kick_t);
        if (gt > 0.5 && s.z < 0.5) s.y = 1.0;
        if (abs(s.y - 1.0) < 0.5) { s.x += dt / max(0.01, 1e-4); if (s.x >= 1.0) { s.x = 1.0; s.y = 2.0; } }
        else if (abs(s.y - 2.0) < 0.5) { float lv = 0.0; s.x = max(lv, s.x - dt * (1.0 - lv) / max(0.4, 1e-4)); if (s.x <= 0.0) s.y = 0.0; }
        else if (abs(s.y - 3.0) < 0.5) { s.x = max(0.0, s.x - dt / max(0.6, 1e-4)); if (s.x <= 0.0) s.y = 0.0; }
        s.z = gt;
      }
      memorypack_0_s = s;
    }
    else if (memorypack_0_i == 1) {
      vec4 s = memorypack_0_s; float dt = memorypack_0_dt;
      if (s.w < 0.5) { s = vec4(0.0, 0.0, 0.0, 1.0); } else {
        if (0.0 > 0.5 && s.z < 0.5) s.x = 0.0;
        if (u_aud_audiosourc_0_kick_t > 0.5 && s.y < 0.5) { s.x += 1.0; if (s.x > 7.0 + 1e-4) s.x = 0.0; else if (s.x < 0.0 - 1e-4) s.x = 7.0; }
        s.y = step(0.5, u_aud_audiosourc_0_kick_t); s.z = step(0.5, 0.0);
      }
      memorypack_0_s = s;
    }
    gl_FragColor = vec4(memorypack_0_s.rgb, memorypack_0_s.a);
}",
