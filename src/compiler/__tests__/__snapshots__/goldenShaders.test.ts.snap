  vec4 b = blKeep4(texture2D(s, uv + t * vec2(0.0, 2.0)), thr, knee);
  vec4 c = blKeep4(texture2D(s, uv + t * vec2(2.0, 2.0)), thr, knee);
  vec4 d = blKeep4(texture2D(s, uv + t * vec2(-2.0, 0.0)), thr, knee);
  vec4 e = blKeep4(texture2D(s, uv), thr, knee);
  vec4 f = blKeep4(texture2D(s, uv + t * vec2(2.0, 0.0)), thr, knee);
  vec4 g = blKeep4(texture2D(s, uv + t * vec2(-2.0, -2.0)), thr, knee);
  vec4 h = blKeep4(texture2D(s, uv + t * vec2(0.0, -2.0)), thr, knee);
  vec4 i = blKeep4(texture2D(s, uv + t * vec2(2.0, -2.0)), thr, knee);
  vec4 j = blKeep4(texture2D(s, uv + t * vec2(-1.0, 1.0)), thr, knee);
  vec4 k = blKeep4(texture2D(s, uv + t * vec2(1.0, 1.0)), thr, knee);
  vec4 l = blKeep4(texture2D(s, uv + t * vec2(-1.0, -1.0)), thr, knee);
  vec4 m = blKeep4(texture2D(s, uv + t * vec2(1.0, -1.0)), thr, knee);
  // Karis average (Jimenez 2014): each of the five 2×2 boxes weighed by 1 / (1 + luma), so one blazing texel can't flicker.
  vec4 b0 = (j + k + l + m) * 0.25, b1 = (a + b + d + e) * 0.25, b2 = (b + c + e + f) * 0.25, b3 = (d + e + g + h) * 0.25, b4 = (e + f + h + i) * 0.25;
  float w0 = 0.5 * blKarisW(b0), w1 = 0.125 * blKarisW(b1), w2 = 0.125 * blKarisW(b2), w3 = 0.125 * blKarisW(b3), w4 = 0.125 * blKarisW(b4);
  return (b0 * w0 + b1 * w1 + b2 * w2 + b3 * w3 + b4 * w4) / (w0 + w1 + w2 + w3 + w4);
}











void main() {
    vec2 g_uv = (vUv - 0.5) * 2.0;
    g_uv.x *= u_resolution.x / u_resolution.y;
    // Grid Rules, Stages: Brian's Brain (Generations /2/3) on a ¼-size board (480 × 270 cells), one step a frame.
    // On cells are pale blue, the dying stage deep blue. Its Texture output (the coloured board as a texture: one more small pass) feeds the Glow.
    vec4 brain_rules_0_c3_b = texture2D(u_pass_brain_rules_cell_0, vUv);
    float brain_rules_0_c3_st = floor(brain_rules_0_c3_b.r + 0.5);
    float brain_rules_0_c3_age = clamp(brain_rules_0_c3_b.g, 0.0, 1.0);
    float brain_rules_0_c3_N = max(floor(u_p_brainxrulesx0xc3_states + 0.5), 2.0);
    vec3 brain_rules_0_c3_col = brain_rules_0_c3_st < 0.5 ? mix(u_p_brainxrulesx0xc3_color0, u_p_brainxrulesx0xc3_glowColor, brain_rules_0_c3_age) : (brain_rules_0_c3_st < 1.5 ? mix(u_p_brainxrulesx0xc3_color1, u_p_brainxrulesx0xc3_oldColor, clamp(u_p_brainxrulesx0xc3_ageFade * brain_rules_0_c3_age, 0.0, 1.0)) : mix(u_p_brainxrulesx0xc3_color2, u_p_brainxrulesx0xc3_color3, clamp((brain_rules_0_c3_st - 2.0) / max(brain_rules_0_c3_N - 3.0, 1.0), 0.0, 1.0)));
    float brain_rules_0_c3_val = brain_rules_0_c3_st / max(brain_rules_0_c3_N - 1.0, 1.0);
    float brain_rules_0_c3_alive = step(0.5, brain_rules_0_c3_st) - step(1.5, brain_rules_0_c3_st);
    // Glow (texture): the bright on cells, spread into a soft light (a bloom chain on the board's Texture).
    vec4 tglow_0_o = blDown13Keep(u_pass_brain_rules_pict_0, vUv, (u_pass_brain_rules_pict_0_px / 1.0), u_p_tglowx0_threshold, u_p_tglowx0_knee);
    gl_FragColor = vec4(tglow_0_o.rgb, tglow_0_o.a);
}",
