    vec4 brain_rules_0_c3_me = texture2D(u_passprev_brain_rules_cell_0, (brain_rules_0_c3_cell + vec2(0.0) + 0.5) / brain_rules_0_c3_res);
    float brain_rules_0_c3_fresh = (abs(brain_rules_0_c3_me.a - 14.0) > 0.5 || u_p_brainxrulesx0xc3_reset > 0.5) ? 1.0 : 0.0;
    float brain_rules_0_c3_clk = (brain_rules_0_c3_fresh > 0.5 ? 0.0 : fract(brain_rules_0_c3_me.b)) + clamp(u_p_brainxrulesx0xc3_rate, 0.0, 1.0);
    float brain_rules_0_c3_tick = step(1.0, brain_rules_0_c3_clk);
    float brain_rules_0_c3_phase = brain_rules_0_c3_clk - brain_rules_0_c3_tick;
    float brain_rules_0_c3_h = grHash(vec3(brain_rules_0_c3_cell, mod(floor(u_time * 60.0), 997.0) + u_p_brainxrulesx0xc3_seed * 1013.0 + 1.0));
    vec2 brain_rules_0_c3_m = u_mouse * 0.25;
    float brain_rules_0_c3_in = (length(brain_rules_0_c3_cell + 0.5 - brain_rules_0_c3_m) < u_p_brainxrulesx0xc3_brushRadius ? 1.0 : 0.0) * max(step(0.5, u_mousebtn), step(0.5, u_p_brainxrulesx0xc3_paint));
    float brain_rules_0_c3_s = floor(brain_rules_0_c3_me.r + 0.5);
