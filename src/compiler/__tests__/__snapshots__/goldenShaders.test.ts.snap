    brain_rules_0_c3_cnt += (step(0.5, brain_rules_0_c3_q) - step(1.5, brain_rules_0_c3_q));
    brain_rules_0_c3_q = texture2D(u_passprev_brain_rules_cell_0, (brain_rules_0_c3_cell + vec2(0.0, -1.0) + 0.5) / brain_rules_0_c3_res).r;
    brain_rules_0_c3_cnt += (step(0.5, brain_rules_0_c3_q) - step(1.5, brain_rules_0_c3_q));
    brain_rules_0_c3_q = texture2D(u_passprev_brain_rules_cell_0, (brain_rules_0_c3_cell + vec2(-1.0, -1.0) + 0.5) / brain_rules_0_c3_res).r;
    brain_rules_0_c3_cnt += (step(0.5, brain_rules_0_c3_q) - step(1.5, brain_rules_0_c3_q));
    brain_rules_0_c3_q = texture2D(u_passprev_brain_rules_cell_0, (brain_rules_0_c3_cell + vec2(-1.0, 0.0) + 0.5) / brain_rules_0_c3_res).r;
    brain_rules_0_c3_cnt += (step(0.5, brain_rules_0_c3_q) - step(1.5, brain_rules_0_c3_q));
    brain_rules_0_c3_q = texture2D(u_passprev_brain_rules_cell_0, (brain_rules_0_c3_cell + vec2(-1.0, 1.0) + 0.5) / brain_rules_0_c3_res).r;
    brain_rules_0_c3_cnt += (step(0.5, brain_rules_0_c3_q) - step(1.5, brain_rules_0_c3_q));
    float brain_rules_0_c3_born = mod(floor((u_p_brainxrulesx0xc3_bornMask + 0.5) / exp2(brain_rules_0_c3_cnt)), 2.0);
    float brain_rules_0_c3_surv = mod(floor((u_p_brainxrulesx0xc3_surviveMask + 0.5) / exp2(brain_rules_0_c3_cnt)), 2.0);
    float brain_rules_0_c3_N = max(floor(u_p_brainxrulesx0xc3_states + 0.5), 2.0);
    float brain_rules_0_c3_top = brain_rules_0_c3_N - 1.0;
    float brain_rules_0_c3_next = brain_rules_0_c3_s < 0.5 ? brain_rules_0_c3_born : (brain_rules_0_c3_s < 1.5 ? (brain_rules_0_c3_surv > 0.5 ? 1.0 : (brain_rules_0_c3_N > 2.5 ? 2.0 : 0.0)) : (brain_rules_0_c3_s + 1.0 > brain_rules_0_c3_N - 0.5 ? 0.0 : brain_rules_0_c3_s + 1.0));
    float brain_rules_0_c3_ng = 0.0;
    if (brain_rules_0_c3_next > 0.5 && brain_rules_0_c3_next < 1.5) brain_rules_0_c3_ng = (brain_rules_0_c3_s > 0.5 && brain_rules_0_c3_s < 1.5) ? min(1.0, brain_rules_0_c3_g + u_p_brainxrulesx0xc3_ageRate) : 0.0;
    else if (brain_rules_0_c3_next < 0.5) brain_rules_0_c3_ng = brain_rules_0_c3_s > 0.5 ? u_p_brainxrulesx0xc3_afterglow : brain_rules_0_c3_g * u_p_brainxrulesx0xc3_afterglow;
    if (brain_rules_0_c3_tick < 0.5) { brain_rules_0_c3_next = brain_rules_0_c3_s; brain_rules_0_c3_ng = brain_rules_0_c3_g; }
    if (brain_rules_0_c3_fresh > 0.5) { brain_rules_0_c3_next = (brain_rules_0_c3_h < u_p_brainxrulesx0xc3_density ? 1.0 : 0.0); brain_rules_0_c3_ng = 0.0; }
    float brain_rules_0_c3_roll = grHash(vec3(brain_rules_0_c3_cell + 0.5, mod(floor(u_time * 60.0), 997.0) + 7919.0));
    if (brain_rules_0_c3_in > 0.5 && brain_rules_0_c3_roll < u_p_brainxrulesx0xc3_brushFill) { brain_rules_0_c3_next = clamp(floor(u_p_brainxrulesx0xc3_brushState + 0.5), 0.0, brain_rules_0_c3_top); brain_rules_0_c3_ng = 0.0; }
    vec3 brain_rules_0_c3_out = vec3(brain_rules_0_c3_next, brain_rules_0_c3_ng, brain_rules_0_c3_phase);
