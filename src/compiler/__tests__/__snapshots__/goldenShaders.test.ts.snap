uniform vec2 u_pass_gas_rules_cells_0_px;
uniform sampler2D u_passprev_gas_rules_cells_0;
uniform vec2 u_passprev_gas_rules_cells_0_px;
uniform float u_mousebtn;

varying vec2 vUv;

// ── Always-available helpers (noise, rotation) ───────────────────────────────
vec2 noiseHash2(vec2 p) {
    p = vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)));
    return -1.0 + 2.0 * fract(sin(p) * 43758.5453123);
}
float noiseHash1(vec2 p) {
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
}
float valueNoise(vec2 p) {
    vec2 i = floor(p); vec2 f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(noiseHash1(i), noiseHash1(i+vec2(1,0)), u.x),
               mix(noiseHash1(i+vec2(0,1)), noiseHash1(i+vec2(1,1)), u.x), u.y);
}
vec2 rotate(vec2 v, float angle) {
    // Hoisted: the angle is usually a uniform expression, and the compiler
    // can't share the four trig calls when the argument isn't a plain value.
    float s = sin(angle), c = cos(angle);
    return vec2(v.x * c - v.y * s, v.x * s + v.y * c);
}
mat2 rot2D(float a) { float s=sin(a), c=cos(a); return mat2(c,-s,s,c); }
// ─────────────────────────────────────────────────────────────────────────

float grHash(vec3 p) {
    vec3 p3 = fract(p * 0.1031);
    p3 = p3 + dot(p3, vec3(p3.z, p3.y, p3.x) + 31.32);
    return fract((p3.x + p3.y) * p3.z);
}
float grMod2048(float x) { return x - 2048.0 * floor(x / 2048.0); }


float grRound(float h, float v) {
    float a = grMod2048(h + grMod2048(v));
    a = grMod2048(a * (2.0 * a + 1.0));
    return grMod2048(a * 32.0) + floor(a / 64.0);
}


float grDice(vec2 key, float frame, float salt, float seed) {
    return grRound(grRound(grRound(grRound(grRound(salt, floor(seed * 2.0)), key.x), key.y), frame), 1013.0) / 2048.0;
}


float grBlockPhase(float strip, float row, float par, float jitter, float frame, float seed) {
    float flip = grDice(vec2(strip, floor(row / 4.0)), frame, 41.0, seed) < jitter * 0.5 ? 1.0 : 0.0;
    return abs(par - flip);
}


vec3 grBlockOf(vec2 cell, float par, vec2 W, float jitter, float frame, float seed, float wrap) {
    float ox = floor((cell.x - par) * 0.5) * 2.0 + par;
    float strip = ox < 0.0 ? ox + W.x : ox;
    float y = cell.y;
    float p0 = grBlockPhase(strip, y, par, jitter, frame, seed);
    float bottom = mod(y - p0, 2.0) < 0.5 ? 1.0 : 0.0;
    float other = bottom > 0.5 ? y + 1.0 : y - 1.0;
    // Wrapped by hand, not with mod(): a division by the board's height can round the wrong way on a GPU.
    float row = wrap > 0.5 ? (other < 0.0 ? other + W.y : (other > W.y - 0.5 ? other - W.y : other)) : other;
    float p1 = grBlockPhase(strip, row, par, jitter, frame, seed);
    return vec3(ox, bottom > 0.5 ? y : y - 1.0, abs(p1 - p0) < 0.5 ? 1.0 : 0.0);
}

void main() {
    vec2 g_uv = (vUv - 0.5) * 2.0;
    g_uv.x *= u_resolution.x / u_resolution.y;
    // Grid Rules, Blocks: the HPP lattice gas (Toffoli and Margolus). In each 2×2 block every particle moves to the opposite corner, except two meeting head-on, which leave at right angles. Four rules, each turned four ways.
    // A ball of gas starts in the middle and spreads; Afterglow leaves faint trails. The board wraps, and no particle is ever lost.
    vec2 gas_rules_0_c2_res = u_resolution;
    vec2 gas_rules_0_c2_cell = floor(gl_FragCoord.xy);
    vec4 gas_rules_0_c2_me = texture2D(u_passprev_gas_rules_cells_0, (gas_rules_0_c2_cell + vec2(0.0) + 0.5) / gas_rules_0_c2_res);
    float gas_rules_0_c2_fresh = (abs(gas_rules_0_c2_me.a - 41.0) > 0.5 || u_p_gasxrulesx0xc2_reset > 0.5) ? 1.0 : 0.0;
    float gas_rules_0_c2_clk = (gas_rules_0_c2_fresh > 0.5 ? 0.0 : fract(gas_rules_0_c2_me.b)) + clamp(u_p_gasxrulesx0xc2_rate, 0.0, 1.0);
    float gas_rules_0_c2_tick = step(1.0, gas_rules_0_c2_clk);
    float gas_rules_0_c2_phase = gas_rules_0_c2_clk - gas_rules_0_c2_tick;
    float gas_rules_0_c2_h = grHash(vec3(gas_rules_0_c2_cell, mod(floor(u_time * 60.0), 997.0) + u_p_gasxrulesx0xc2_seed * 1013.0 + 1.0));
    vec2 gas_rules_0_c2_m = u_mouse * 0.25;
    float gas_rules_0_c2_in = (length(gas_rules_0_c2_cell + 0.5 - gas_rules_0_c2_m) < u_p_gasxrulesx0xc2_brushRadius ? 1.0 : 0.0) * max(step(0.5, u_mousebtn), step(0.5, u_p_gasxrulesx0xc2_paint));
    float gas_rules_0_c2_s = floor(gas_rules_0_c2_me.r + 0.5);
    float gas_rules_0_c2_g = gas_rules_0_c2_me.g;
    float gas_rules_0_c2_top = max(floor(u_p_gasxrulesx0xc2_states + 0.5), 2.0) - 1.0;
    float gas_rules_0_c2_par = step(1.5, gas_rules_0_c2_me.b);
    vec2 gas_rules_0_c2_W = floor(gas_rules_0_c2_res * 0.5) * 2.0;
    float gas_rules_0_c2_frame = mod(floor(u_time * 60.0), 997.0);
    vec3 gas_rules_0_c2_blk = grBlockOf(gas_rules_0_c2_cell, gas_rules_0_c2_par, gas_rules_0_c2_W, clamp(u_p_gasxrulesx0xc2_jitter, 0.0, 1.0), gas_rules_0_c2_frame, u_p_gasxrulesx0xc2_seed, 1.0);
    vec2 gas_rules_0_c2_org = gas_rules_0_c2_blk.xy;
    vec2 gas_rules_0_c2_q = gas_rules_0_c2_cell - gas_rules_0_c2_org;
    float gas_rules_0_c2_qi = gas_rules_0_c2_q.x + (1.0 - gas_rules_0_c2_q.y) * 2.0;
    float gas_rules_0_c2_live = step(gas_rules_0_c2_cell.x, gas_rules_0_c2_W.x - 0.5) * step(gas_rules_0_c2_cell.y, gas_rules_0_c2_W.y - 0.5);
    vec2 gas_rules_0_c2_key = mod(gas_rules_0_c2_org, gas_rules_0_c2_W);
    float gas_rules_0_c2_b0 = floor(texture2D(u_passprev_gas_rules_cells_0, (mod(gas_rules_0_c2_org + vec2(0.0, 1.0), gas_rules_0_c2_W) + 0.5) / gas_rules_0_c2_res).r + 0.5);
    float gas_rules_0_c2_b1 = floor(texture2D(u_passprev_gas_rules_cells_0, (mod(gas_rules_0_c2_org + vec2(1.0, 1.0), gas_rules_0_c2_W) + 0.5) / gas_rules_0_c2_res).r + 0.5);
    float gas_rules_0_c2_b2 = floor(texture2D(u_passprev_gas_rules_cells_0, (mod(gas_rules_0_c2_org + vec2(0.0, 0.0), gas_rules_0_c2_W) + 0.5) / gas_rules_0_c2_res).r + 0.5);
    float gas_rules_0_c2_b3 = floor(texture2D(u_passprev_gas_rules_cells_0, (mod(gas_rules_0_c2_org + vec2(1.0, 0.0), gas_rules_0_c2_W) + 0.5) / gas_rules_0_c2_res).r + 0.5);
    float gas_rules_0_c2_next = gas_rules_0_c2_s;
    float gas_rules_0_c2_done = 1.0 - gas_rules_0_c2_blk.z;
    float gas_rules_0_c2_o0 = floor(grDice(gas_rules_0_c2_key, gas_rules_0_c2_frame, 31.0, u_p_gasxrulesx0xc2_seed) * 4.0);
    float gas_rules_0_c2_best0 = 0.0;
    float gas_rules_0_c2_pick0 = -1.0;
    float gas_rules_0_c2_m0_0 = (abs(gas_rules_0_c2_b0 - 1.0) < 0.5 && abs(gas_rules_0_c2_b1 - 0.0) < 0.5 && abs(gas_rules_0_c2_b2 - 0.0) < 0.5 && abs(gas_rules_0_c2_b3 - 0.0) < 0.5) ? 4.0 - mod(0.0 - gas_rules_0_c2_o0 + 4.0, 4.0) : 0.0;
    if (gas_rules_0_c2_m0_0 > gas_rules_0_c2_best0) { gas_rules_0_c2_best0 = gas_rules_0_c2_m0_0; gas_rules_0_c2_pick0 = 0.0; }
    float gas_rules_0_c2_m0_1 = (abs(gas_rules_0_c2_b0 - 0.0) < 0.5 && abs(gas_rules_0_c2_b1 - 1.0) < 0.5 && abs(gas_rules_0_c2_b2 - 0.0) < 0.5 && abs(gas_rules_0_c2_b3 - 0.0) < 0.5) ? 4.0 - mod(1.0 - gas_rules_0_c2_o0 + 4.0, 4.0) : 0.0;
    if (gas_rules_0_c2_m0_1 > gas_rules_0_c2_best0) { gas_rules_0_c2_best0 = gas_rules_0_c2_m0_1; gas_rules_0_c2_pick0 = 1.0; }
    float gas_rules_0_c2_m0_2 = (abs(gas_rules_0_c2_b0 - 0.0) < 0.5 && abs(gas_rules_0_c2_b1 - 0.0) < 0.5 && abs(gas_rules_0_c2_b2 - 0.0) < 0.5 && abs(gas_rules_0_c2_b3 - 1.0) < 0.5) ? 4.0 - mod(2.0 - gas_rules_0_c2_o0 + 4.0, 4.0) : 0.0;
    if (gas_rules_0_c2_m0_2 > gas_rules_0_c2_best0) { gas_rules_0_c2_best0 = gas_rules_0_c2_m0_2; gas_rules_0_c2_pick0 = 2.0; }
    float gas_rules_0_c2_m0_3 = (abs(gas_rules_0_c2_b0 - 0.0) < 0.5 && abs(gas_rules_0_c2_b1 - 0.0) < 0.5 && abs(gas_rules_0_c2_b2 - 1.0) < 0.5 && abs(gas_rules_0_c2_b3 - 0.0) < 0.5) ? 4.0 - mod(3.0 - gas_rules_0_c2_o0 + 4.0, 4.0) : 0.0;
    if (gas_rules_0_c2_m0_3 > gas_rules_0_c2_best0) { gas_rules_0_c2_best0 = gas_rules_0_c2_m0_3; gas_rules_0_c2_pick0 = 3.0; }
    if (gas_rules_0_c2_done < 0.5 && gas_rules_0_c2_best0 > 0.5) { gas_rules_0_c2_next = (gas_rules_0_c2_qi < 0.5 ? (gas_rules_0_c2_pick0 < 0.5 ? 0.0 : (gas_rules_0_c2_pick0 < 1.5 ? 0.0 : (gas_rules_0_c2_pick0 < 2.5 ? 1.0 : 0.0))) : (gas_rules_0_c2_qi < 1.5 ? (gas_rules_0_c2_pick0 < 0.5 ? 0.0 : (gas_rules_0_c2_pick0 < 1.5 ? 0.0 : (gas_rules_0_c2_pick0 < 2.5 ? 0.0 : 1.0))) : (gas_rules_0_c2_qi < 2.5 ? (gas_rules_0_c2_pick0 < 0.5 ? 0.0 : (gas_rules_0_c2_pick0 < 1.5 ? 1.0 : (gas_rules_0_c2_pick0 < 2.5 ? 0.0 : 0.0))) : (gas_rules_0_c2_pick0 < 0.5 ? 1.0 : (gas_rules_0_c2_pick0 < 1.5 ? 0.0 : (gas_rules_0_c2_pick0 < 2.5 ? 0.0 : 0.0)))))); gas_rules_0_c2_done = 1.0; }
    float gas_rules_0_c2_o1 = floor(grDice(gas_rules_0_c2_key, gas_rules_0_c2_frame, 33.0, u_p_gasxrulesx0xc2_seed) * 2.0);
    float gas_rules_0_c2_best1 = 0.0;
    float gas_rules_0_c2_pick1 = -1.0;
    float gas_rules_0_c2_m1_0 = (abs(gas_rules_0_c2_b0 - 1.0) < 0.5 && abs(gas_rules_0_c2_b1 - 0.0) < 0.5 && abs(gas_rules_0_c2_b2 - 0.0) < 0.5 && abs(gas_rules_0_c2_b3 - 1.0) < 0.5) ? 2.0 - mod(0.0 - gas_rules_0_c2_o1 + 2.0, 2.0) : 0.0;
    if (gas_rules_0_c2_m1_0 > gas_rules_0_c2_best1) { gas_rules_0_c2_best1 = gas_rules_0_c2_m1_0; gas_rules_0_c2_pick1 = 0.0; }
    float gas_rules_0_c2_m1_1 = (abs(gas_rules_0_c2_b0 - 0.0) < 0.5 && abs(gas_rules_0_c2_b1 - 1.0) < 0.5 && abs(gas_rules_0_c2_b2 - 1.0) < 0.5 && abs(gas_rules_0_c2_b3 - 0.0) < 0.5) ? 2.0 - mod(1.0 - gas_rules_0_c2_o1 + 2.0, 2.0) : 0.0;
    if (gas_rules_0_c2_m1_1 > gas_rules_0_c2_best1) { gas_rules_0_c2_best1 = gas_rules_0_c2_m1_1; gas_rules_0_c2_pick1 = 1.0; }
    if (gas_rules_0_c2_done < 0.5 && gas_rules_0_c2_best1 > 0.5) { gas_rules_0_c2_next = (gas_rules_0_c2_qi < 0.5 ? (gas_rules_0_c2_pick1 < 0.5 ? 0.0 : 1.0) : (gas_rules_0_c2_qi < 1.5 ? (gas_rules_0_c2_pick1 < 0.5 ? 1.0 : 0.0) : (gas_rules_0_c2_qi < 2.5 ? (gas_rules_0_c2_pick1 < 0.5 ? 1.0 : 0.0) : (gas_rules_0_c2_pick1 < 0.5 ? 0.0 : 1.0)))); gas_rules_0_c2_done = 1.0; }
    float gas_rules_0_c2_o2 = floor(grDice(gas_rules_0_c2_key, gas_rules_0_c2_frame, 35.0, u_p_gasxrulesx0xc2_seed) * 4.0);
    float gas_rules_0_c2_best2 = 0.0;
    float gas_rules_0_c2_pick2 = -1.0;
    float gas_rules_0_c2_m2_0 = (abs(gas_rules_0_c2_b0 - 1.0) < 0.5 && abs(gas_rules_0_c2_b1 - 1.0) < 0.5 && abs(gas_rules_0_c2_b2 - 0.0) < 0.5 && abs(gas_rules_0_c2_b3 - 0.0) < 0.5) ? 4.0 - mod(0.0 - gas_rules_0_c2_o2 + 4.0, 4.0) : 0.0;
    if (gas_rules_0_c2_m2_0 > gas_rules_0_c2_best2) { gas_rules_0_c2_best2 = gas_rules_0_c2_m2_0; gas_rules_0_c2_pick2 = 0.0; }
    float gas_rules_0_c2_m2_1 = (abs(gas_rules_0_c2_b0 - 0.0) < 0.5 && abs(gas_rules_0_c2_b1 - 1.0) < 0.5 && abs(gas_rules_0_c2_b2 - 0.0) < 0.5 && abs(gas_rules_0_c2_b3 - 1.0) < 0.5) ? 4.0 - mod(1.0 - gas_rules_0_c2_o2 + 4.0, 4.0) : 0.0;
    if (gas_rules_0_c2_m2_1 > gas_rules_0_c2_best2) { gas_rules_0_c2_best2 = gas_rules_0_c2_m2_1; gas_rules_0_c2_pick2 = 1.0; }
    float gas_rules_0_c2_m2_2 = (abs(gas_rules_0_c2_b0 - 0.0) < 0.5 && abs(gas_rules_0_c2_b1 - 0.0) < 0.5 && abs(gas_rules_0_c2_b2 - 1.0) < 0.5 && abs(gas_rules_0_c2_b3 - 1.0) < 0.5) ? 4.0 - mod(2.0 - gas_rules_0_c2_o2 + 4.0, 4.0) : 0.0;
    if (gas_rules_0_c2_m2_2 > gas_rules_0_c2_best2) { gas_rules_0_c2_best2 = gas_rules_0_c2_m2_2; gas_rules_0_c2_pick2 = 2.0; }
    float gas_rules_0_c2_m2_3 = (abs(gas_rules_0_c2_b0 - 1.0) < 0.5 && abs(gas_rules_0_c2_b1 - 0.0) < 0.5 && abs(gas_rules_0_c2_b2 - 1.0) < 0.5 && abs(gas_rules_0_c2_b3 - 0.0) < 0.5) ? 4.0 - mod(3.0 - gas_rules_0_c2_o2 + 4.0, 4.0) : 0.0;
    if (gas_rules_0_c2_m2_3 > gas_rules_0_c2_best2) { gas_rules_0_c2_best2 = gas_rules_0_c2_m2_3; gas_rules_0_c2_pick2 = 3.0; }
    if (gas_rules_0_c2_done < 0.5 && gas_rules_0_c2_best2 > 0.5) { gas_rules_0_c2_next = (gas_rules_0_c2_qi < 0.5 ? (gas_rules_0_c2_pick2 < 0.5 ? 0.0 : (gas_rules_0_c2_pick2 < 1.5 ? 1.0 : (gas_rules_0_c2_pick2 < 2.5 ? 1.0 : 0.0))) : (gas_rules_0_c2_qi < 1.5 ? (gas_rules_0_c2_pick2 < 0.5 ? 0.0 : (gas_rules_0_c2_pick2 < 1.5 ? 0.0 : (gas_rules_0_c2_pick2 < 2.5 ? 1.0 : 1.0))) : (gas_rules_0_c2_qi < 2.5 ? (gas_rules_0_c2_pick2 < 0.5 ? 1.0 : (gas_rules_0_c2_pick2 < 1.5 ? 1.0 : (gas_rules_0_c2_pick2 < 2.5 ? 0.0 : 0.0))) : (gas_rules_0_c2_pick2 < 0.5 ? 1.0 : (gas_rules_0_c2_pick2 < 1.5 ? 0.0 : (gas_rules_0_c2_pick2 < 2.5 ? 0.0 : 1.0)))))); gas_rules_0_c2_done = 1.0; }
    float gas_rules_0_c2_o3 = floor(grDice(gas_rules_0_c2_key, gas_rules_0_c2_frame, 37.0, u_p_gasxrulesx0xc2_seed) * 4.0);
    float gas_rules_0_c2_best3 = 0.0;
    float gas_rules_0_c2_pick3 = -1.0;
    float gas_rules_0_c2_m3_0 = (abs(gas_rules_0_c2_b0 - 1.0) < 0.5 && abs(gas_rules_0_c2_b1 - 1.0) < 0.5 && abs(gas_rules_0_c2_b2 - 1.0) < 0.5 && abs(gas_rules_0_c2_b3 - 0.0) < 0.5) ? 4.0 - mod(0.0 - gas_rules_0_c2_o3 + 4.0, 4.0) : 0.0;
    if (gas_rules_0_c2_m3_0 > gas_rules_0_c2_best3) { gas_rules_0_c2_best3 = gas_rules_0_c2_m3_0; gas_rules_0_c2_pick3 = 0.0; }
    float gas_rules_0_c2_m3_1 = (abs(gas_rules_0_c2_b0 - 1.0) < 0.5 && abs(gas_rules_0_c2_b1 - 1.0) < 0.5 && abs(gas_rules_0_c2_b2 - 0.0) < 0.5 && abs(gas_rules_0_c2_b3 - 1.0) < 0.5) ? 4.0 - mod(1.0 - gas_rules_0_c2_o3 + 4.0, 4.0) : 0.0;
    if (gas_rules_0_c2_m3_1 > gas_rules_0_c2_best3) { gas_rules_0_c2_best3 = gas_rules_0_c2_m3_1; gas_rules_0_c2_pick3 = 1.0; }
    float gas_rules_0_c2_m3_2 = (abs(gas_rules_0_c2_b0 - 0.0) < 0.5 && abs(gas_rules_0_c2_b1 - 1.0) < 0.5 && abs(gas_rules_0_c2_b2 - 1.0) < 0.5 && abs(gas_rules_0_c2_b3 - 1.0) < 0.5) ? 4.0 - mod(2.0 - gas_rules_0_c2_o3 + 4.0, 4.0) : 0.0;
    if (gas_rules_0_c2_m3_2 > gas_rules_0_c2_best3) { gas_rules_0_c2_best3 = gas_rules_0_c2_m3_2; gas_rules_0_c2_pick3 = 2.0; }
    float gas_rules_0_c2_m3_3 = (abs(gas_rules_0_c2_b0 - 1.0) < 0.5 && abs(gas_rules_0_c2_b1 - 0.0) < 0.5 && abs(gas_rules_0_c2_b2 - 1.0) < 0.5 && abs(gas_rules_0_c2_b3 - 1.0) < 0.5) ? 4.0 - mod(3.0 - gas_rules_0_c2_o3 + 4.0, 4.0) : 0.0;
    if (gas_rules_0_c2_m3_3 > gas_rules_0_c2_best3) { gas_rules_0_c2_best3 = gas_rules_0_c2_m3_3; gas_rules_0_c2_pick3 = 3.0; }
    if (gas_rules_0_c2_done < 0.5 && gas_rules_0_c2_best3 > 0.5) { gas_rules_0_c2_next = (gas_rules_0_c2_qi < 0.5 ? (gas_rules_0_c2_pick3 < 0.5 ? 0.0 : (gas_rules_0_c2_pick3 < 1.5 ? 1.0 : (gas_rules_0_c2_pick3 < 2.5 ? 1.0 : 1.0))) : (gas_rules_0_c2_qi < 1.5 ? (gas_rules_0_c2_pick3 < 0.5 ? 1.0 : (gas_rules_0_c2_pick3 < 1.5 ? 0.0 : (gas_rules_0_c2_pick3 < 2.5 ? 1.0 : 1.0))) : (gas_rules_0_c2_qi < 2.5 ? (gas_rules_0_c2_pick3 < 0.5 ? 1.0 : (gas_rules_0_c2_pick3 < 1.5 ? 1.0 : (gas_rules_0_c2_pick3 < 2.5 ? 1.0 : 0.0))) : (gas_rules_0_c2_pick3 < 0.5 ? 1.0 : (gas_rules_0_c2_pick3 < 1.5 ? 1.0 : (gas_rules_0_c2_pick3 < 2.5 ? 0.0 : 1.0)))))); gas_rules_0_c2_done = 1.0; }
    gas_rules_0_c2_next = clamp(gas_rules_0_c2_next, 0.0, gas_rules_0_c2_top);
    float gas_rules_0_c2_ng = 0.0;
    if (abs(gas_rules_0_c2_next - gas_rules_0_c2_s) < 0.5) gas_rules_0_c2_ng = gas_rules_0_c2_next > 0.5 ? min(1.0, gas_rules_0_c2_g + u_p_gasxrulesx0xc2_ageRate) : gas_rules_0_c2_g * u_p_gasxrulesx0xc2_afterglow;
    else gas_rules_0_c2_ng = gas_rules_0_c2_next < 0.5 ? u_p_gasxrulesx0xc2_afterglow : 0.0;
    if (gas_rules_0_c2_tick < 0.5) { gas_rules_0_c2_next = gas_rules_0_c2_s; gas_rules_0_c2_ng = gas_rules_0_c2_g; }
