  vec4 l = texture2D(s, uv + t * vec2(-1.0, -1.0));
  vec4 m = texture2D(s, uv + t * vec2(1.0, -1.0));
  return e * 0.125 + (a + c + g + i) * 0.03125 + (b + d + f + h) * 0.0625 + (j + k + l + m) * 0.125;
}













