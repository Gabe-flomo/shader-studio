    "u_p_curvetracex0xc2_beamColor",
    "u_p_curvetracex0xc2_beamWidth",
    "u_p_curvetracex0xc2_brightness",
    "u_p_curvetracex0xc2_damping",
    "u_p_curvetracex0xc2_dwell",
    "u_p_curvetracex0xc2_freqX",
    "u_p_curvetracex0xc2_freqY",
    "u_p_curvetracex0xc2_glow",
